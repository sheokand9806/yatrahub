{
  "name": "yatrahub",
  "version": "3.0.0",
  "description": "YatraHub - discover and book tours across India. Node/Express/MongoDB REST API with a React (Vite) front-end.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -k -n api,client -c green,cyan \"npm run server\" \"npm run client\"",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "import-data": "node dev-data/data/import-dev-data.js --import",
    "delete-data": "node dev-data/data/import-dev-data.js --delete"
  },
  "author": "YatraHub",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "qs": "^6.16.0",
    "razorpay": "^2.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "validator": "^13.15.35",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  }
}
